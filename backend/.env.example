# SECURE HOSPITALITY - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and fill in real secrets. NEVER commit actual credentials!

NODE_ENV=production
PORT=5050
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/secure_hospitality?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_high_entropy_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://secure-hospitality.com,http://localhost:3000
LOG_LEVEL=info